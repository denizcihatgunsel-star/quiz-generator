generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role          String   @default("student") // "student", "teacher", or "admin"
  customLogoUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscription     Subscription?
  usages           UsageRecord[]
  quizzes          SavedQuiz[]
  flashcardReviews FlashcardReview[]
  streak           UserStreak?
  xpEvents         XpEvent[]
  classroomSessions ClassroomSession[]
  referralCode      String?  @unique
  referredBy        String?
  bonusQuizzes      Int      @default(0)
  apiKeys           ApiKey[]
  teamId            String?  // team this user belongs to
  team              Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  ownedTeam         Team?    @relation("TeamOwner")
}

model SavedQuiz {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String
  data      String   // JSON string of full quiz
  score     Int?
  total     Int?
  shareId   String?  @unique
  isPublic  Boolean  @default(false) // published to public library
  createdAt DateTime @default(now())
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String   @default("free")
  status               String   @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String   // "2026-03"
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
}

// Spaced repetition cards derived from flashcards
model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId       String
  cardIndex    Int      // index within the quiz's flashcard array
  front        String
  back         String
  interval     Int      @default(0)    // days until next review
  repetition   Int      @default(0)    // number of consecutive correct reviews
  efactor      Float    @default(2.5)  // ease factor
  dueDate      DateTime @default(now())
  lastReviewed DateTime?
  createdAt    DateTime @default(now())

  @@unique([userId, quizId, cardIndex])
}

// Gamification: streaks and XP
model UserStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String?  // "2026-04-10" — date of last quiz/review activity
  totalXp        Int      @default(0)
  level          Int      @default(1)
  streakFreezes  Int      @default(1) // free freezes available
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// XP event log
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // "quiz_generated", "quiz_scored", "flashcard_reviewed", "streak_bonus"
  xp        Int
  createdAt DateTime @default(now())
}

// Live classroom quiz sessions
model ClassroomSession {
  id              String   @id @default(cuid())
  hostId          String
  host            User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  code            String   @unique // 6-digit join code
  topic           String
  quizData        String   // JSON string of questions (multipleChoice + trueFalse)
  status          String   @default("lobby") // "lobby", "active", "question", "results", "finished"
  currentQuestion Int      @default(-1) // index of current question, -1 = not started
  totalQuestions  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  participants    ClassroomParticipant[]
}

model ClassroomParticipant {
  id        String   @id @default(cuid())
  sessionId String
  session   ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nickname  String
  score     Int      @default(0)
  answers   String   @default("[]") // JSON array of { questionIndex, answerIndex, correct, timeMs }
  createdAt DateTime @default(now())

  @@unique([sessionId, nickname])
}

// API Keys for programmatic access
model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   @unique // "exm_" prefixed key
  name      String   @default("Default")
  lastUsed  DateTime?
  createdAt DateTime @default(now())
}

// Teams for shared quiz libraries
model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   User[]   @relation("TeamMembers")
  inviteCode String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
